# CharityStride Frontend Environment Configuration

# Backend API URL (Default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth 2.0 Client ID (From Google Cloud Console)
# Used for Google Sign-In on /login and /register
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Maps JavaScript API Key (From Google Cloud Console)
# Used for Event Location Picker & NGO Venue Mapping
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Laravel Reverb (WebSocket for Real-time Notifications & Live Capacity)
NEXT_PUBLIC_REVERB_APP_KEY=charitystride_key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
