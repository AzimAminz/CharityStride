APP_NAME=CharityStride
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Database Connection (Use 'db' when running inside Docker, or '127.0.0.1' for local)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=charitystride
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email / SMTP Settings (Gmail App Password or Mailtrap)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@charitystride.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth 2.0 (From Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Laravel Reverb (WebSocket Broadcasting)
REVERB_APP_ID=charitystride_app
REVERB_APP_KEY=charitystride_key
REVERB_APP_SECRET=charitystride_secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8080
